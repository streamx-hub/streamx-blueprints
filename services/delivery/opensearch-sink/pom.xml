<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.streamx.blueprints</groupId>
    <artifactId>delivery</artifactId>
    <version>3.0.0-SNAPSHOT</version>
    <relativePath>../pom.xml</relativePath>
  </parent>

  <artifactId>opensearch-sink</artifactId>
  <name>StreamX Blueprints : Opensearch Sink</name>
  <properties>
    <elasticsearch-evolution-core.version>0.6.0</elasticsearch-evolution-core.version>
    <json-path.version>2.9.0</json-path.version>
  </properties>

  <dependencies>
    <dependency>
      <groupId>com.streamx</groupId>
      <artifactId>reactive-messaging-http-cloudevents</artifactId>
    </dependency>
    <dependency>
      <groupId>com.streamx.blueprints</groupId>
      <artifactId>data-model</artifactId>
    </dependency>
    <dependency>
      <groupId>com.streamx.blueprints</groupId>
      <artifactId>cloud-events-support</artifactId>
    </dependency>
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-rest-jackson</artifactId>
    </dependency>
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-elasticsearch-rest-client</artifactId>
    </dependency>
    <dependency>
      <groupId>com.jayway.jsonpath</groupId>
      <artifactId>json-path</artifactId>
      <version>${json-path.version}</version>
    </dependency>
    <dependency>
      <groupId>com.senacor.elasticsearch.evolution</groupId>
      <artifactId>elasticsearch-evolution-core</artifactId>
